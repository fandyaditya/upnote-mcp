{
  "name": "@fandyaditya/upnote-mcp",
  "version": "0.1.0",
  "description": "Unofficial MCP server for UpNote: create and revise notes (tables, images, checklists) through UpNote's URL scheme, and read them from the local database in read-only mode",
  "type": "module",
  "bin": {
    "upnote-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "upnote",
    "notes",
    "macos",
    "ai-agent"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test \"test/*.test.mjs\""
  },
  "os": [
    "darwin",
    "win32",
    "linux"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fandyaditya/upnote-mcp.git"
  },
  "homepage": "https://github.com/fandyaditya/upnote-mcp#readme",
  "bugs": {
    "url": "https://github.com/fandyaditya/upnote-mcp/issues"
  }
}
